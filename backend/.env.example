# ==============================================================================
# J.A.R.V.I.S. Core Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env inside the backend/ folder for local runtime.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Server Port
PORT=3000
PREFER_LOCAL=true

# Google Gemini API Keys (Tiered multi-key failover pool)
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3

# Fast Inference LLM Providers (Groq / OpenRouter / OpenAI)
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENAI_API_KEY=your_openai_api_key

# Neural TTS (ElevenLabs API Keys pool)
ELEVENLABS_API_KEY_1=your_elevenlabs_key_1
ELEVENLABS_VOICE_ID=your_voice_id_or_default

# Biometric Voice Print Security
VOICE_CONFIDENCE_THRESHOLD=0.57
MASTER_UI_PIN=7410

# Telegram & Mobile Companion Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
CLOUD_WORKER_URL=https://your-cloud-worker.onrender.com
CLOUD_WORKER_SECRET=your_cloud_worker_shared_secret
